{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Natural Display Calculator",
  "mainBinaryName": "Natural Display Calculator",
  "version": "1.0.0",
  "identifier": "io.github.noelchan127.calculator",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-networking --disable-component-update",
        "title": "Natural Display Calculator",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Noel Chan",
    "copyright": "Copyright (C) 2026 Noel Chan",
    "license": "GPL-3.0-or-later",
    "resources": {
      "../../LICENSE": "LICENSE.txt",
      "../../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "category": "Education",
    "shortDescription": "Scientific and graphing calculator with natural display",
    "longDescription": "Scientific and graphing calculator with natural (textbook) display, step-by-step derivative, integral, algebra, matrix and geometry calculators. Works offline.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
